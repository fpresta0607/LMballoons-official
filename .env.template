# Resend API key for contact form emails
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=

# --- Admin media panel ---
# Supabase project URL and keys (Project Settings -> API Keys).
# NEXT_PUBLIC_* is sent to the browser (publishable key is safe there).
# The secret key is server-only — never expose it or commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Password the business owner types at /admin to log in.
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie (e.g. `openssl rand -base64 32`).
ADMIN_SESSION_SECRET=
